{
  "component": {
    "name": "salesforce",
    "types": ["integration-v10.1"],
    "description": "Sends Extole events to Salesforce CRM via authenticated webhook — keeps Contact and Lead records in sync when advocates earn rewards, share links, or refer friends.",
    "tags": ["internal:type:integration", "internal:self-managed"],
    "settings": [
      {
        "name": "short.description",
        "values": { "default": "Send Extole events to Salesforce CRM contacts and leads." },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "about",
        "values": { "default": "When Extole events fire (reward earned, share clicked, friend registered), this integration POSTs the event data to your Salesforce org's REST endpoint, updating the matching Contact or Lead record automatically." },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "categories",
        "values": { "default": "CRM" },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "imageKey",
        "values": { "default": "salesforce" },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "documentation.url",
        "values": { "default": "https://dev.extole.com/docs/salesforce-integration" },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "external.url",
        "values": { "default": "https://salesforce.com" },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "external.integration.url",
        "values": { "default": "https://salesforce.com/setup/integrations" },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "logo",
        "type": "IMAGE",
        "values": { "default": null },
        "tags": ["internal:ui-display"]
      },
      {
        "name": "sfdcEndpointUrl",
        "display_name": "Salesforce Endpoint URL",
        "description": "Copy from the Extole 'Receive Events' tab in your Salesforce org. Format: https://your-org.my.salesforce.com/services/apexrest/extole/events",
        "type": "STRING",
        "values": { "default": "" },
        "tags": ["importance:basic"]
      },
      {
        "name": "clientKey",
        "display_name": "Salesforce OAuth Credentials",
        "description": "OAuth 2.0 client credentials (consumer key + consumer secret) from your Salesforce Connected App. Used to obtain bearer tokens for the REST API.",
        "type": "CLIENT_KEY",
        "tags": ["importance:basic"]
      },
      {
        "name": "writebackEventNames",
        "display_name": "Events to Write Back",
        "description": "Comma-separated list of Extole event names that will be POSTed to Salesforce. Match these with the Event Name values in your Extole_Writeback_Cfg__c rules.",
        "type": "STRING",
        "values": { "default": "reward_earned,friend_registered" },
        "tags": ["importance:basic"]
      },
      {
        "name": "views",
        "display_name": "Views",
        "type": "MULTI_SOCKET",
        "filters": [
          { "type": "COMPONENT_TYPE", "component_type": "config-view-v10.0" },
          { "type": "COMPONENT_TYPE", "component_type": "event-stream-view-v10.0" }
        ],
        "tags": ["internal:view"],
        "priority": "40"
      }
    ]
  },
  "elements": {
    "webhooks": [
      {
        "name": "javascript@buildtime:context.getComponent().getName() + '_writeback'",
        "url": "setting:sfdcEndpointUrl",
        "authentication": {
          "algorithm": "OAUTH_SFDC",
          "credentials": "setting:clientKey"
        },
        "request": "%{evaluatables/sfdc-request.js}%",
        "description": "POSTs Extole event data to the Salesforce REST endpoint. Authenticated via OAuth 2.0 client credentials from the configured Connected App.",
        "enabled": true,
        "default_method": "POST",
        "type": "GENERIC",
        "tags": [
          "internal:app_type=salesforce",
          "internal:app_data:event_type=writeback"
        ],
        "retry_intervals": [60, 300, 900]
      }
    ],
    "campaign": {
      "steps": [
        {
          "journey_name": "salesforce_writeback_participant",
          "type": "JOURNEY_ENTRY"
        },
        {
          "type": "CONTROLLER",
          "name": "sfdc_writeback",
          "scope": "PRIVATE",
          "enabled_on_states": ["LIVE", "PAUSED"],
          "journey_names": ["salesforce_writeback_participant"],
          "selectors": ["MATCHING_CAMPAIGN"],
          "enabled": "true",
          "triggers": [
            {
              "trigger_phase": "MATCHING",
              "trigger_name": "EVENT",
              "event_type": "STEP",
              "event_names": "javascript@buildtime:(context.getVariableContext().get('writebackEventNames') || 'reward_earned,friend_registered').split(',').map(function(s){ return s.trim(); }).filter(function(s){ return s.length > 0; })",
              "trigger_type": "EVENT"
            }
          ],
          "actions": [
            {
              "action_type": "WEBHOOK",
              "quality": "HIGH",
              "enabled": "true",
              "webhook_id": "javascript@buildtime:(function(){ var children = Java.from(context.getComponent().getParent().getChildren()); var found = null; children.forEach(function(c){ if (found) return; var hooks = Java.from(c.createElementsQuery().withType('WEBHOOK').withTag('internal:app_type=salesforce').list()); if (hooks && hooks.length > 0) { found = hooks[0].getId(); } }); return found; })()",
              "data": {
                "email":         "spel@runtime:context.person.email",
                "event_name":    "spel@runtime:context.step.name",
                "event_id":      "spel@runtime:context.step.id",
                "salesforce_id": "spel@runtime:context.person.data['salesforce_id'] ?: null"
              }
            }
          ]
        }
      ]
    }
  }
}
